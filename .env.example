# Copy to .env. Do not commit deployment values or secret files.
SMON_ENVIRONMENT=production
SMON_PUBLIC_ORIGIN=https://monitor.example.com
SMON_CF_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
SMON_CF_AUDIENCE=
# Use your host UID/GID so application containers can read mode-0600 secret files.
SMON_UID=1000
SMON_GID=1000
# Exact origins, as JSON arrays. Empty means no monitoring destinations allowed.
SMON_ALLOWED_MONITOR_ORIGINS=[]
SMON_ALLOWED_HTTP_ORIGINS=[]
